---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Início" description="Devmove — ferramentas abertas, úteis e sem rastreadores.">
  <section class="hero-home">
    <div>
      <p class="eyebrow">Projetos pequenos. Impacto real.</p>
      <h1>Construímos ferramentas que respeitam você.</h1>
      <p class="lead">O Devmove é um grupo de desenvolvedores criando ferramentas incríveis, abertas e sem rastreadores — uma ideia de cada vez.</p>
      <div class="actions"><a class="btn" href={`${base}projetos`}>Conheça os projetos <span>→</span></a><a class="btn secondary" href={`${base}sobre`}>Sobre o Devmove</a></div>
    </div>
    <div class="rocket" aria-hidden="true"><span>🚀</span><i></i><i></i><i></i></div>
  </section>

  <section class="section" id="projetos">
    <div class="section-heading"><div><p class="eyebrow">O que estamos fazendo</p><h2>Confira nossos projetos</h2></div><a href={`${base}projetos`}>Ver todos →</a></div>
    <ProjectExplorer lang="pt" featuredOnly />
  </section>

  <section class="section split-section">
    <div><p class="eyebrow">Quem faz acontecer</p><h2>Construído em público</h2><p class="lead">Cada projeto é uma oportunidade de aprender, documentar e abrir espaço para mais gente construir junto.</p><a href={`${base}contato`}>Quer participar? Fale com a gente →</a></div>
    <div class="collaborators"><div class="avatar">D</div><div><strong>Devmove</strong><p>Colaboradores dos projetos aparecem aqui conforme a comunidade cresce.</p></div></div>
  </section>
</BaseLayout>
