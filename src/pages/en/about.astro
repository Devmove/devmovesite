---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About" description="Learn about Devmove, its mission, and how to participate."><p class="eyebrow">Behind the code</p><h1>About Devmove</h1><p class="lead">Devmove is an initiative dedicated to building open, useful, and accessible tools.</p><section class="section content-narrow"><h2>Our mission</h2><p>To learn in public, document the process, and make it easier for new developers to participate through clearly scoped projects and straightforward documentation.</p><div class="actions"><a class="btn" href={`${base}en/projects`}>See projects →</a></div></section></BaseLayout>
